{
  "$defs": {
    "ObservedStyle": {
      "description": "Style properties observed on a Segment.\n\nField names mirror the keys produced by\n`legal_format_engine.merge_with_rules` so the diff is direct.",
      "properties": {
        "alignment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment"
        },
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bold"
        },
        "font_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Name"
        },
        "font_size_pt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Pt"
        },
        "indent_inches": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indent Inches"
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Italic"
        },
        "line_spacing": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Spacing"
        },
        "margin_bottom_inches": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Bottom Inches"
        },
        "margin_left_inches": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Left Inches"
        },
        "margin_right_inches": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Right Inches"
        },
        "margin_top_inches": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin Top Inches"
        }
      },
      "title": "ObservedStyle",
      "type": "object"
    },
    "SegmentKind": {
      "enum": [
        "heading",
        "paragraph",
        "footnote",
        "block_quote",
        "table_cell"
      ],
      "title": "SegmentKind",
      "type": "string"
    }
  },
  "description": "A logical unit of a Document \u2014 heading, paragraph, footnote, etc.\n\n`text_hash` references the segment's content. The plaintext itself\nlives in an encrypted blob; checkers retrieve it via\n`CheckContext.get_text(segment)`.",
  "properties": {
    "char_length": {
      "title": "Char Length",
      "type": "integer"
    },
    "citation_span_ids": {
      "items": {
        "type": "string"
      },
      "title": "Citation Span Ids",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SegmentKind"
    },
    "ordinal": {
      "title": "Ordinal",
      "type": "integer"
    },
    "style_observed": {
      "$ref": "#/$defs/ObservedStyle"
    },
    "text_hash": {
      "title": "Text Hash",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "ordinal",
    "text_hash",
    "char_length"
  ],
  "title": "Segment",
  "type": "object"
}
